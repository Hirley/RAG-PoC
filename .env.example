ANTHROPIC_API_KEY=
# Only needed for identity-linked API keys, which the API rejects with a 400
# unless the request names the workspace it acts in. Leave blank for a
# standard Console API key.
ANTHROPIC_WORKSPACE_ID=
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_docs

# Optional. Model to generate with; the default is claude-sonnet-5, which is
# ample for answering from retrieved context. This is the real cost lever.
ANTHROPIC_MODEL=
# Optional. Upper bound on generated tokens, default 4096. Only generated
# tokens are billed, so this caps a runaway generation, not the normal price.
# Thinking tokens count against it too, and an answer that hits the ceiling
# fails loudly rather than coming back truncated.
ANTHROPIC_MAX_TOKENS=
