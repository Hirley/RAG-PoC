# Which LLM answers. One of: anthropic (default), openai, groq.
# `rag ask --provider <name>` overrides this for a single question.
LLM_PROVIDER=

# Upper bound on generated tokens, default 4096, shared by every provider.
# Only generated tokens are billed, so this caps a runaway generation, not
# the normal price. Thinking tokens count against it too, and an answer
# that hits the ceiling fails loudly rather than coming back truncated.
LLM_MAX_TOKENS=

# One key per provider -- only the selected one is required. Each is the
# name that provider's own SDK already expects.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Only needed for identity-linked Anthropic keys, which the API rejects
# with a 400 unless the request names the workspace it acts in. Leave
# blank for a standard Console API key.
ANTHROPIC_WORKSPACE_ID=

# Optional per-provider model override. Each falls back to that provider's
# own default when blank.
ANTHROPIC_MODEL=
OPENAI_MODEL=
GROQ_MODEL=

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_docs
